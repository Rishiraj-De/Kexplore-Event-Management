NODE_ENV=development
PORT=4000
# MongoDB Atlas connection string (Database → Connect → Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kexplore?retryWrites=true&w=majority
# Long random string used to sign session cookies
JWT_SECRET=change-me
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
# Comma-separated front-end origins allowed by CORS
CLIENT_URL=http://localhost:5173
